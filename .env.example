# Connection string do MySQL. Em produção (Coolify), aponte para o banco já
# hospedado; em desenvolvimento local, pode usar o serviço opcional do
# docker-compose (docker compose --profile dev up) com:
#   mysql://app:app@localhost:3306/desempenho_rfs
DATABASE_URL="mysql://usuario:senha@host:3306/nome_do_banco"

# Segredo usado para assinar/verificar o cookie de sessão (HS256).
# Obrigatório, mínimo de 32 caracteres. Gere um valor único por ambiente com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="troque-este-valor-por-um-segredo-aleatorio-de-producao"
