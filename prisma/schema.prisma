// Schema do Sistema de Gestão de Produção, Metas e Ranking de Operadores.
// Nenhum tipo de seguro/sócio ou operador é fixo no código: tipos_seguro e
// tipos_socio são a fonte de verdade e todas as tabelas de meta/lançamento
// referenciam-nas dinamicamente via tipo_seguro_id / tipo_socio_id.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMIN
  OPERADOR
}

model Operador {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  login     String   @unique @db.VarChar(60)
  perfil    Perfil
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lancamentosDiarios   LancamentoDiario[]
  importacoesPlanilha  ImportacaoPlanilha[]

  @@index([ativo])
  @@map("operadores")
}

model ImportacaoPlanilha {
  id             Int      @id @default(autoincrement())
  nomeArquivo    String   @map("nome_arquivo") @db.VarChar(255)
  importadoPorId Int      @map("importado_por_id")
  importadoPor   Operador @relation(fields: [importadoPorId], references: [id])
  importadoEm    DateTime @default(now()) @map("importado_em")
  totalLinhas    Int      @map("total_linhas")

  linhas ImportacaoLinha[]

  @@index([importadoEm])
  @@map("importacoes_planilha")
}

model ImportacaoLinha {
  id              Int                @id @default(autoincrement())
  importacaoId    Int                @map("importacao_id")
  importacao      ImportacaoPlanilha @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  linhaOriginal   Int                @map("linha_original")
  divisao         String?            @db.VarChar(120)
  regional        String?            @db.VarChar(120)
  loja            String?            @db.VarChar(160)
  codLoja         String?            @map("cod_loja") @db.VarChar(40)
  drt             String?            @db.VarChar(40)
  nome            String?            @db.VarChar(160)
  cargo           String?            @db.VarChar(160)
  dtAdmissao      DateTime?          @map("dt_admissao")
  situacao        String?            @db.VarChar(40)
  lojaTransversal String?            @map("loja_transversal") @db.VarChar(10)
  mesesTrabalho   Float?             @map("meses_trabalho")
  /// Estrutura aninhada { [grupoMetrica]: { [periodo]: { [campo]: valor } } },
  /// espelhando os grupos/colunas originais da planilha importada.
  dados           Json

  @@index([importacaoId])
  @@index([nome])
  @@index([loja])
  @@map("importacoes_linhas")
}

model TipoSeguro {
  id        Int      @id @default(autoincrement())
  nome      String   @unique @db.VarChar(120)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  metasSeguros       MetaSeguroMensal[]
  lancamentosSeguros LancamentoSeguroDiario[]

  @@index([ativo])
  @@map("tipos_seguro")
}

model TipoSocio {
  id        Int      @id @default(autoincrement())
  nome      String   @unique @db.VarChar(120)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  metasSocios       MetaSocioMensal[]
  lancamentosSocios LancamentoSocioDiario[]

  @@index([ativo])
  @@map("tipos_socio")
}

/// Meta mensal individual — o mesmo alvo vale para todos os operadores
/// ativos (não é configurada por operador). Uma única linha por mês/ano.
/// As metas por tipo de seguro/sócio ficam em MetaSeguroMensal/MetaSocioMensal
/// (1:N), permitindo qualquer quantidade de tipos ativos sem alterar esta tabela.
model MetaMensal {
  id            Int      @id @default(autoincrement())
  mes           Int      @db.TinyInt
  ano           Int
  metaDigitadas Int      @default(0) @map("meta_digitadas") @db.UnsignedInt
  metaContas    Int      @default(0) @map("meta_contas") @db.UnsignedInt
  createdAt     DateTime @default(now()) @map("created_at")

  metasSeguros MetaSeguroMensal[]
  metasSocios  MetaSocioMensal[]

  @@unique([mes, ano])
  @@map("metas_mensais")
}

model MetaSeguroMensal {
  id             Int @id @default(autoincrement())
  metaMensalId   Int @map("meta_mensal_id")
  tipoSeguroId   Int @map("tipo_seguro_id")
  quantidadeMeta Int @default(0) @map("quantidade_meta") @db.UnsignedInt

  metaMensal MetaMensal @relation(fields: [metaMensalId], references: [id], onDelete: Cascade)
  tipoSeguro TipoSeguro @relation(fields: [tipoSeguroId], references: [id], onDelete: Restrict)

  @@unique([metaMensalId, tipoSeguroId])
  @@index([tipoSeguroId])
  @@map("metas_seguros_mensais")
}

model MetaSocioMensal {
  id             Int @id @default(autoincrement())
  metaMensalId   Int @map("meta_mensal_id")
  tipoSocioId    Int @map("tipo_socio_id")
  quantidadeMeta Int @default(0) @map("quantidade_meta") @db.UnsignedInt

  metaMensal MetaMensal @relation(fields: [metaMensalId], references: [id], onDelete: Cascade)
  tipoSocio  TipoSocio  @relation(fields: [tipoSocioId], references: [id], onDelete: Restrict)

  @@unique([metaMensalId, tipoSocioId])
  @@index([tipoSocioId])
  @@map("metas_socios_mensais")
}

/// Lançamento diário consolidado (digitadas/contas) de um operador. Os
/// lançamentos por tipo de seguro/sócio ficam em LancamentoSeguroDiario e
/// LancamentoSocioDiario (1:N).
model LancamentoDiario {
  id           Int      @id @default(autoincrement())
  operadorId   Int      @map("operador_id")
  data         DateTime @db.Date
  qtdDigitadas Int      @default(0) @map("qtd_digitadas") @db.UnsignedInt
  qtdContas    Int      @default(0) @map("qtd_contas") @db.UnsignedInt
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  operador Operador                 @relation(fields: [operadorId], references: [id], onDelete: Restrict)
  seguros  LancamentoSeguroDiario[]
  socios   LancamentoSocioDiario[]

  @@unique([operadorId, data])
  @@index([data])
  @@map("lancamentos_diarios")
}

model LancamentoSeguroDiario {
  id                 Int @id @default(autoincrement())
  lancamentoDiarioId Int @map("lancamento_diario_id")
  tipoSeguroId       Int @map("tipo_seguro_id")
  quantidade         Int @default(0) @db.UnsignedInt

  lancamentoDiario LancamentoDiario @relation(fields: [lancamentoDiarioId], references: [id], onDelete: Cascade)
  tipoSeguro       TipoSeguro       @relation(fields: [tipoSeguroId], references: [id], onDelete: Restrict)

  @@unique([lancamentoDiarioId, tipoSeguroId])
  @@index([tipoSeguroId])
  @@map("lancamentos_seguros_diarios")
}

model LancamentoSocioDiario {
  id                 Int @id @default(autoincrement())
  lancamentoDiarioId Int @map("lancamento_diario_id")
  tipoSocioId        Int @map("tipo_socio_id")
  quantidade         Int @default(0) @db.UnsignedInt

  lancamentoDiario LancamentoDiario @relation(fields: [lancamentoDiarioId], references: [id], onDelete: Cascade)
  tipoSocio        TipoSocio        @relation(fields: [tipoSocioId], references: [id], onDelete: Restrict)

  @@unique([lancamentoDiarioId, tipoSocioId])
  @@index([tipoSocioId])
  @@map("lancamentos_socios_diarios")
}
